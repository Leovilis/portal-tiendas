// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELOS DE USUARIOS Y AUTENTICACIÓN
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // Solo si no usa OAuth
  image         String?
  role          Role      @default(USER)
  tiendaId      String?   @unique
  tienda        Tienda?   @relation(fields: [tiendaId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relaciones
  pedidos       Pedido[]
  reviews       Review[]
  
  @@map("users")
}

enum Role {
  USER
  VENDEDOR
  ADMIN
}

// ============================================
// MODELOS DE TIENDAS
// ============================================

model Tienda {
  id                String      @id @default(cuid())
  nombre            String
  slug              String      @unique
  logo              String?
  portada           String?
  descripcion       String?
  categoria         String
  ubicacion         String?
  telefono          String?
  email             String?
  sitioWeb          String?
  esOficial         Boolean     @default(false)
  esVerificada      Boolean     @default(false)
  tiempoRespuesta   String      @default("Responde en minutos")
  nivel             Nivel       @default(BRONCE)
  rating            Float       @default(0)
  totalReviews      Int         @default(0)
  productosDestacados Int      @default(0)
  configuracion     Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  // Relaciones
  usuario           User?
  productos         Producto[]
  pedidos           Pedido[]
  reviews           Review[]
  integraciones     Integracion[]
  config            TiendaConfig?
  
  @@map("tiendas")
}

enum Nivel {
  BRONCE
  PLATA
  ORO
  PLATINO
}

model TiendaConfig {
  id              String    @id @default(cuid())
  tiendaId        String    @unique
  tienda          Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  
  // Métodos de pago
  mercadoPago     Boolean   @default(false)
  mercadoPagoKey  String?
  stripe          Boolean   @default(false)
  stripeKey       String?
  
  // Integraciones
  instagram       Boolean   @default(false)
  instagramToken  String?
  googleShopping  Boolean   @default(false)
  googleToken     String?
  whatsapp        Boolean   @default(false)
  whatsappNumber  String?
  
  // Personalización
  colores         Json?
  customDomain    String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("tienda_configs")
}

// ============================================
// MODELOS DE PRODUCTOS
// ============================================

model Producto {
  id              String      @id @default(cuid())
  tiendaId        String
  tienda          Tienda      @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  
  nombre          String
  slug            String      @unique
  descripcion     String
  precio          Float
  precioOferta    Float?
  imagenes        String[]    // ✅ Array requerido (puede estar vacío)
  categoria       String
  subcategoria    String?
  stock           Int         @default(0)
  rating          Float       @default(0)
  totalReviews    Int         @default(0)
  esNuevo         Boolean     @default(false)
  esDestacado     Boolean     @default(false)
  tieneEnvioGratis Boolean   @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relaciones
  pedidos         PedidoProducto[]
  reviews         Review[]
  
  @@map("productos")
}

// ============================================
// MODELOS DE PEDIDOS
// ============================================

model Pedido {
  id              String      @id @default(cuid())
  tiendaId        String
  tienda          Tienda      @relation(fields: [tiendaId], references: [id])
  usuarioId       String?
  usuario         User?       @relation(fields: [usuarioId], references: [id])
  
  estado          EstadoPedido @default(PENDIENTE)
  total           Float
  subtotal        Float
  impuestos       Float       @default(0)
  envio           Float       @default(0)
  
  // Datos de envío
  direccion       Json
  
  // Datos de pago
  metodoPago      String
  transaccionId   String?
  pagado          Boolean     @default(false)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relaciones
  productos       PedidoProducto[]
  historial       PedidoHistorial[]
  
  @@map("pedidos")
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
  DEVUELTO
}

model PedidoProducto {
  id            String    @id @default(cuid())
  pedidoId      String
  pedido        Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId    String
  producto      Producto  @relation(fields: [productoId], references: [id])
  
  cantidad      Int
  precioUnitario Float
  subtotal      Float
  
  createdAt     DateTime  @default(now())
  
  @@map("pedido_productos")
}

model PedidoHistorial {
  id            String    @id @default(cuid())
  pedidoId      String
  pedido        Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  
  estado        EstadoPedido
  descripcion   String?
  createdAt     DateTime  @default(now())
  
  @@map("pedido_historial")
}

// ============================================
// MODELOS DE RESEÑAS - CORREGIDO ✅
// ============================================

model Review {
  id            String    @id @default(cuid())
  productoId    String
  producto      Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       User      @relation(fields: [usuarioId], references: [id])
  tiendaId      String
  tienda        Tienda    @relation(fields: [tiendaId], references: [id])
  
  rating        Int       // 1-5
  comentario    String?
  imagenes      String[]  // ✅ Array requerido (puede estar vacío)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("reviews")
}

// ============================================
// MODELOS DE INTEGRACIONES
// ============================================

model Integracion {
  id            String    @id @default(cuid())
  tiendaId      String
  tienda        Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  
  tipo          TipoIntegracion
  activo        Boolean   @default(true)
  configuracion Json
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("integraciones")
}

enum TipoIntegracion {
  INSTAGRAM_SHOPPING
  GOOGLE_SHOPPING
  WHATSAPP
  MERCADO_PAGO
  STRIPE
}